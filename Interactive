                const response = await fetch(window.location.href, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ command: inputVal })
                });
                
                const data = await response.json();
                
                // TRIGGER 3D ANIMATIONS BASED ON PYTHON RESPONSE
                if (data.action_type === 'warp') {
                    targetSpeed = 60.0; // Extreme warp speed!
                    setTimeout(() => targetSpeed = 0.5, 4000); // Drop out of warp after 4s
                } else if (data.action_type === 'scan') {
                    targetSpeed = 0.1; // Halt to scan
                    planet.scale.set(1.5, 1.5, 1.5); // Pulse planet size
                    setTimeout(() => { targetSpeed = 0.5; planet.scale.set(1, 1, 1); }, 2000);
                } else {
                    targetSpeed = 0.5;
                }
                
                // Update the terminal UI
                document.getElementById('statusMsg').innerText = data.status;
                document.getElementById('sectorVal').innerText = data.sector;
                document.getElementById('distVal').innerText = data.distance_ly;
                document.getElementById('telemetry').classList.remove('hidden');
                
            } catch (error) {
                document.getElementById('statusMsg').innerText = "SUBSPACE COMMS FAILURE";
                targetSpeed = 0.5;
            }
            
            btn.innerText = 'TRANSMIT TO ORBIT';
            btn.style.opacity = '1';
        }
    </script>
</body>
</html>
"""

def lambda_handler(event, context):
    http_method = event.get('requestContext', {}).get('http', {}).get('method', 'GET')
    
    # POST REQUEST: Terminal command received from the browser
    if http_method == 'POST':
        try:
            body = json.loads(event.get('body', '{}'))
            command = body.get('command', '').lower()
            
            # --- PYTHON BACKEND LOGIC ---
            sector = f"{random.randint(10, 99)}-{random.choice('ABCDEF')}"
            distance = random.randint(4, 1000)
            
            # Process command string to determine output and 3D action
            if "warp" in command:
                speed_factor = distance / random.uniform(1.2, 5.0)
                status = f"Warping to Sector {sector} at factor {speed_factor:.1f}"
                action_type = "warp"
            elif "scan" in command:
                anomalies = random.randint(0, 3)
                status = f"Scan complete. {anomalies} anomalies found in {sector}."
                action_type = "scan"
            else:
                status = f"Coordinates locked on Sector {sector}."
                action_type = "idle"
                
            return {
                "statusCode": 200,
                "headers": {"Content-Type": "application/json"},
                "body": json.dumps({
                    "status": status,
                    "action_type": action_type,
                    "sector": sector,
                    "distance_ly": distance
                })
            }
        except Exception as e:
            return {"statusCode": 400, "body": json.dumps({"error": str(e)})}
            
    # GET REQUEST: Initial page load, serve the 3D Engine and HTML
    return {
        "statusCode": 200,
        "headers": {
            "Content-Type": "text/html" 
        },
        "body": HTML_CONTENT
    }
