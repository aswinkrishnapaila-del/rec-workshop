        function animate() {
            requestAnimationFrame(animate);

            // Smoothly interpolate speed (handles the warp transition)
            currentSpeed += (targetSpeed - currentSpeed) * 0.05;

            // Rotate central entity
            planet.rotation.y += 0.002 * currentSpeed;
            planet.rotation.x += 0.001 * currentSpeed;
            core.rotation.y -= 0.003 * currentSpeed;

            // Apply camera parallax
            camera.position.x += (mouseX - camera.position.x) * 0.05;
            camera.position.y += (-mouseY - camera.position.y) * 0.05;
            camera.lookAt(scene.position);

